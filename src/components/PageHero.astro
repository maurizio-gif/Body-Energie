---
/*
 * Hero di una pagina interna: foto a tutta larghezza con velo scuro, titolo grande
 * (con parole che ruotano, se sono piu' d'una: ruotano a turno nello stesso punto) e i pulsanti passati come slot.
 * Va usata con <Layout headerTone="overlay">: la foto passa sotto l'header (fisso,
 * chiaro e un po' trasparente). Alta come la hero della home. Nessun sottotitolo.
 *
 *   <PageHero image="/wp-content/uploads/…jpg" title="group" words={['cycling']}>
 *     <a class="btn btn--lg" href="/…">…</a>
 *   </PageHero>
 */
import Img from './Img.astro';

interface Props {
	image: string;
	title: string;
	/** Parola/e che chiudono il titolo. Se sono piu' di una ruotano (la prima si vede subito). */
	words?: string[];
	/** Descrizione della foto (vuota se e' solo decorativa). */
	imageAlt?: string;
}

const { image, title, words = [], imageAlt = '' } = Astro.props;
// Con piu' parole il titolo le fa ruotare. Nel codice resta solo la parola visibile in quel
// momento (le altre le scrive lo script a turno): cosi' l'h1 e' "acqua fitness" e non
// "acqua fitness gym bike". La parola piu' lunga tiene fissa la larghezza (vedi ::after).
const ruota = words.length > 1;
const piuLunga = [...words].sort((a, b) => b.length - a.length)[0] ?? '';
---

<section class="ph">
	<Img src={image} alt={imageAlt} class="img-cover" sizes="100vw" priority />
	<div class="ph__overlay"></div>
	<div class="ph__content">
		<h1 class="display-title ph__title" data-intro style="--intro-delay: 0.1s">
			{title}
			{
				words.length > 0 && (
					<>
						{' '}
						<span class="ph__rot" data-words={ruota ? JSON.stringify(words) : undefined} data-sizer={ruota ? piuLunga : undefined}>
							<span class="ph__word">{words[0]}</span>
						</span>
					</>
				)
			}
		</h1>
		{
			Astro.slots.has('default') && (
				<div class="ph__actions" data-intro style="--intro-delay: 0.25s">
					<slot />
				</div>
			)
		}
	</div>
</section>

<style>
	.ph {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		/* Una schermata intera, come la hero della home (HeroCarousel), anche su mobile. */
		min-height: 100vh;
		min-height: 100svh;
		padding: calc(var(--header-h) + 32px) var(--gutter) 56px;
		overflow: hidden;
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.ph__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.61);
	}

	.ph__content {
		position: relative;
		z-index: 1;
		text-align: center;
	}

	.ph__title {
		color: var(--bg-alt);
		text-transform: uppercase;
	}

	/* La parola che ruota sta in una cella larga quanto la parola piu' lunga (data-sizer,
	   invisibile): il titolo non cambia larghezza (e non scatta) quando una sostituisce l'altra. */
	.ph__rot {
		display: inline-grid;
		color: var(--accent-secondary);
	}

	.ph__rot[data-sizer]::after {
		content: attr(data-sizer);
		grid-area: 1 / 1;
		height: 0;
		overflow: hidden;
		visibility: hidden;
	}

	.ph__word {
		grid-area: 1 / 1;
		text-align: left;
	}

	.ph__rot[data-words] .ph__word {
		transition: opacity 0.5s ease, transform 0.6s var(--ease-out-crit);
	}

	.ph__rot[data-words] .ph__word.is-out {
		opacity: 0;
		transform: translateY(0.35em);
	}

	/* Stessa altezza per <button> e <a>: l'interlinea predefinita e' diversa. */
	.ph__actions :global(.btn) {
		line-height: 1.2;
	}

	.ph__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 16px;
		margin-top: 36px;
	}

	/* Mobile: pulsanti piu' compatti (i pulsanti sono passati dallo slot, quindi :global). */
	@media (max-width: 900px) {
		.ph {
			padding-bottom: 40px;
		}

		.ph__actions {
			gap: 10px;
			margin-top: 24px;
		}

		.ph__actions :global(.btn) {
			padding: 13px 24px;
			font-size: 15px;
		}
	}

	/* Telefono: pulsanti in colonna, tutti larghi come il piu' largo (non come il titolo). */
	@media (max-width: 560px) {
		.ph__actions {
			flex-direction: column;
			align-items: stretch;
			width: fit-content;
			margin-inline: auto;
		}
	}
</style>

<script>
	// Fa ruotare le parole del titolo (una alla volta); con "riduci movimento" resta la prima.
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelectorAll<HTMLElement>('[data-words]').forEach((rot) => {
			const parole: string[] = JSON.parse(rot.dataset.words ?? '[]');
			const parola = rot.querySelector<HTMLElement>('.ph__word');
			if (!parola || parole.length < 2) return;
			let i = 0;
			setInterval(() => {
				parola.classList.add('is-out');
				window.setTimeout(() => {
					i = (i + 1) % parole.length;
					parola.textContent = parole[i];
					parola.classList.remove('is-out');
				}, 500);
			}, 2800);
		});
	}
</script>
