---
/*
 * Un blocco di una scheda (corso o servizio): video, foto o carosello da un lato;
 * titolo, descrizione, durata, "cosa portare" e barre di intensita' dall'altro.
 * Una pagina ha uno o piu' blocchi: `reverse` li alterna sinistra/destra. Senza
 * media il testo occupa una colonna di lettura.
 *
 * `tone="arancio"`: stesso layout su fondo arancione, con testo nero (come le fasce
 * arancioni della home).
 *
 *   <CourseBlock blocco={…} fallbackImage="/wp-content/uploads/…jpg" reverse />
 */
import { idSezione } from '../lib/ancora';
import Img from './Img.astro';
import ImageSlider from './ImageSlider.astro';
import SectionTitle from './SectionTitle.astro';

interface Blocco {
	/** Ancora (#id) per i collegamenti interni della pagina. */
	id?: string | null;
	titolo: string | null;
	sottotitolo: string | null;
	descrizioneHtml: string;
	video?: string | null;
	/** Una foto, o piu' foto in carosello. */
	immagini?: string[];
	/** "contain" per i loghi: mostrati interi su fondo bianco invece di essere ritagliati. */
	adattamento?: 'cover' | 'contain';
	dettagli: { testo: string; icona: string | null }[];
	/** Riquadro di approfondimento sotto la descrizione (es. orari e modalita'). */
	extra?: { titolo: string; html: string } | null;
	portareTitolo: string | null;
	portare: { etichetta: string; immagine: string | null }[];
	intensita: { etichetta: string; valore: number }[];
}

interface Props {
	blocco: Blocco;
	/** Foto da usare se il blocco non ha ne' video ne' foto (le schede corso). */
	fallbackImage?: string;
	/** Media a destra e testo a sinistra. */
	reverse?: boolean;
	/** Senza spazio sotto: un elenco di ancore segue subito dopo il blocco. */
	compatto?: boolean;
	/** Sfondo: "dark" nero, "soft" grigio scuro, "arancio" arancione con testo nero
	 *  (per alternare i blocchi). */
	tone?: 'dark' | 'soft' | 'arancio';
}

const { blocco, fallbackImage, reverse = false, tone = 'dark', compatto = false } = Astro.props;
const mediaAnim = reverse ? 'from-right' : 'from-left';
const textAnim = reverse ? 'from-left' : 'from-right';

const immagini = blocco.immagini?.length ? blocco.immagini : !blocco.video && fallbackImage ? [fallbackImage] : [];
const haMedia = !!blocco.video || immagini.length > 0;
const nomeMedia = blocco.titolo ?? 'della pagina';
// Descrizione per le foto (utile anche alla ricerca per immagini): solo se il blocco ha un titolo.
const descrizioneFoto = blocco.titolo ? `${blocco.titolo} - Body Energie, Villafranca di Verona` : undefined;
const arancio = tone === 'arancio';
---

<section id={idSezione(blocco)} class:list={['cb', { 'on-dark': !arancio }, `cb--${tone}`, { 'cb--reverse': reverse, 'cb--solo': !haMedia, 'cb--compatto': compatto }]}>
	<div class="cb__grid container-wide">
		{
			haMedia && (
				<div class:list={['cb__media', { 'cb__media--contain': blocco.adattamento === 'contain' }]} data-anim={mediaAnim}>
					{blocco.video ? (
						<>
							<video class="cb__video" src={blocco.video} muted loop playsinline preload="metadata" aria-label={`Video: ${nomeMedia}`} />
							<button type="button" class="cb__vbtn" aria-label="Metti in pausa il video" hidden>
								<svg class="cb__vbtn-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" />
								</svg>
								<svg class="cb__vbtn-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path d="M8 5v14l11-7z" fill="currentColor" />
								</svg>
							</button>
						</>
					) : immagini.length > 1 ? (
						<ImageSlider images={immagini} label={`Foto: ${nomeMedia}`} alt={descrizioneFoto} />
					) : (
						<Img src={immagini[0]} alt={descrizioneFoto ?? ''} class="img-cover" sizes="(max-width: 900px) 90vw, 46vw" />
					)}
				</div>
			)
		}

		<div class="cb__text" data-anim={haMedia ? textAnim : 'up'} data-anim-delay="80">
			{blocco.titolo && (
				<SectionTitle tone={arancio ? 'on-accent' : 'dark-bg'} flush gap={22}>
					{blocco.titolo}
				</SectionTitle>
			)}

			{blocco.sottotitolo && <p class:list={['pill', { 'pill--dark': arancio }, 'cb__sub']}>{blocco.sottotitolo}</p>}

			<div class="cb__desc" set:html={blocco.descrizioneHtml} />

			{
				blocco.dettagli.length > 0 && (
					<ul class="cb__chips">
						{blocco.dettagli.map((d) => (
							<li class="cb__chip">
								{d.icona?.includes('clock') && (
									<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
										<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
										<path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
								{d.testo}
							</li>
						))}
					</ul>
				)
			}

			{
				blocco.extra && (
					<div class="cb__extra">
						<h3 class="cb__h3">{blocco.extra.titolo}</h3>
						<div class="cb__desc" set:html={blocco.extra.html} />
					</div>
				)
			}

			{
				blocco.portare.length > 0 && (
					<div class="cb__bring">
						<h3 class="cb__h3">{blocco.portareTitolo ?? 'Cosa portare'}</h3>
						<ul class="cb__bring-list">
							{blocco.portare.map((p, i) => (
								<li class="cb__bring-item" data-anim="pop" style={`transition-delay:${i * 90}ms`}>
									{p.immagine && <Img src={p.immagine} alt="" sizes="64px" />}
									<span>{p.etichetta}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			{
				blocco.intensita.length > 0 && (
					<div class="cb__bars" data-anim="fade">
						<h3 class="cb__h3">Intensità</h3>
						<ul class="cb__bars-list">
							{blocco.intensita.map((b, i) => (
								<li class="cb__bar" style={`--v:${b.valore / 100};--i:${i}`}>
									<span class="cb__bar-label">{b.etichetta}</span>
									<span
										class="cb__track"
										role="meter"
										aria-label={b.etichetta}
										aria-valuemin="0"
										aria-valuemax="100"
										aria-valuenow={b.valore}
									>
										<span class="cb__fill" />
									</span>
									<span class="cb__bar-val">{b.valore}%</span>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>
	</div>

	{
		Astro.slots.has('default') && (
			<div class="cb__planning container-wide">
				<slot />
			</div>
		)
	}
</section>

<style>
	/* Contenuto sotto il blocco (gli orari del corso): resta dentro la stessa sezione, stesso sfondo. */
	.cb__planning {
		margin-top: clamp(28px, 4vw, 44px);
	}

	.cb {
		/* Se si arriva con un'ancora (es. da /orari) l'header fisso non copre il titolo. */
		scroll-margin-top: var(--header-h);
		padding-block: clamp(48px, 7vw, 96px);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.cb--soft {
		background: var(--bg-dark-soft);
	}

	/* ---- Variante arancione: fondo arancione, testo nero ---- */
	.cb--arancio {
		background: var(--accent);
		color: var(--text);
	}

	.cb--arancio .cb__desc,
	.cb--arancio .cb__h3 {
		color: var(--text);
	}

	.cb--arancio .cb__desc :global(a) {
		color: var(--text);
	}

	.cb--arancio .cb__chip {
		border-color: var(--bg-dark);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.cb--arancio .cb__extra {
		background: rgba(0, 0, 0, 0.12);
	}

	.cb--arancio .cb__bring-item {
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.cb--arancio .cb__track {
		background: rgba(0, 0, 0, 0.25);
	}

	.cb--arancio .cb__fill {
		background: var(--bg-dark);
	}

	.cb--arancio .cb__bar-val {
		color: var(--text);
	}

	.cb__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(32px, 5vw, 72px);
		align-items: start;
	}

	.cb--reverse .cb__media {
		order: 2;
	}

	/* Senza media: una sola colonna di testo a misura di lettura, allineata a sinistra
	   come il resto della pagina (stesso margine dei titoli e dei blocchi con foto). */
	.cb--solo {
		padding-block: clamp(32px, 4vw, 56px);
	}

	.cb--solo .cb__grid {
		grid-template-columns: minmax(0, 60rem);
		justify-content: start;
	}

	.cb--compatto {
		padding-bottom: 0;
	}

	.cb--solo .cb__desc :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Loghi: interi, su fondo bianco, senza il ritaglio dei bordi. */
	.cb__media.cb__media--contain {
		background: #fff;
	}

	.cb__media--contain :global(img) {
		object-fit: contain;
		padding: 6%;
	}

	/* ---- Video / foto ---- */
	/* Il testo e' piu' alto del video: il video resta agganciato sotto l'header
	   mentre si legge. */
	.cb__media {
		position: sticky;
		top: calc(var(--header-h) + 24px);
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-lg);
		background: var(--bg-dark);
	}

	.cb__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cb__vbtn {
		position: absolute;
		right: 12px;
		bottom: 12px;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.6);
		color: var(--text-on-dark);
		cursor: pointer;
		transition: background var(--dur-base);
	}

	.cb__vbtn:hover {
		background: var(--accent);
	}

	.cb__vbtn:focus-visible {
		outline: 3px solid var(--text-on-dark);
		outline-offset: 2px;
	}

	.cb__vbtn-play {
		display: none;
	}

	.cb__vbtn[data-paused] .cb__vbtn-pause {
		display: none;
	}

	.cb__vbtn[data-paused] .cb__vbtn-play {
		display: block;
	}

	/* ---- Testo ---- */
	.cb__text :global(.st__title) {
		text-transform: uppercase;
	}

	.cb__sub {
		margin: 0 0 16px;
	}

	.cb__desc {
		font-size: var(--text-md);
		line-height: 1.7;
		color: var(--text-on-dark);
	}

	.cb__desc :global(p) {
		margin: 0 0 1em;
	}

	.cb__desc :global(a) {
		color: var(--accent);
	}

	.cb__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 8px 0 0;
		padding: 0;
		list-style: none;
	}

	.cb__chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--border-on-dark);
		background: rgba(255, 255, 255, 0.08);
		color: var(--text-on-dark);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.cb__chip svg {
		color: var(--accent);
	}

	.cb__extra {
		margin-top: 28px;
		padding: 22px 24px 8px;
		border-radius: var(--radius-lg);
		background: var(--bg-dark-soft);
	}

	.cb--soft .cb__extra {
		background: var(--bg-dark);
	}

	.cb__h3 {
		margin: 0 0 14px;
		font-size: var(--text-sm);
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-on-dark);
	}

	/* ---- Cosa portare ---- */
	.cb__bring {
		margin-top: 32px;
	}

	.cb__bring-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cb__bring-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		padding: 16px 8px;
		border-radius: var(--radius-lg);
		background: var(--bg-dark-soft);
		font-size: var(--text-xs);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-align: center;
	}

	.cb--soft .cb__bring-item {
		background: var(--bg-dark);
	}

	.cb__bring-item :global(img) {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	/* ---- Intensita' ---- */
	.cb__bars {
		margin-top: 32px;
	}

	.cb__bars-list {
		display: grid;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cb__bar {
		display: grid;
		grid-template-columns: 7.5rem 1fr 3rem;
		align-items: center;
		gap: 14px;
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.cb__bar-val {
		text-align: right;
		color: var(--text-muted-on-dark);
	}

	.cb__track {
		display: block;
		height: 10px;
		overflow: hidden;
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.18);
	}

	.cb__fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
		transform: scaleX(var(--v));
		transform-origin: left;
	}

	/* La barra si riempie quando il blocco entra in vista (solo con JS e
	   senza richiesta di ridurre il movimento: altrimenti e' gia' piena). */
	@media (prefers-reduced-motion: no-preference) {
		:global(.js) .cb__fill {
			transform: scaleX(0);
			transition: transform 1.2s var(--ease-out-crit) calc(var(--i) * 150ms + 250ms);
		}

		:global(.js) .cb__bars.is-visible .cb__fill {
			transform: scaleX(var(--v));
		}
	}

	@media (max-width: 900px) {
		.cb__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		/* Su una colonna il video sta sempre sopra al testo. */
		.cb--reverse .cb__media {
			order: 0;
		}

		.cb__media {
			position: relative;
			top: auto;
		}
	}

	@media (max-width: 560px) {
		.cb__bar {
			grid-template-columns: 6rem 1fr 2.6rem;
			gap: 10px;
		}
	}
</style>

<script>
	// Il video parte (muto, in loop) solo quando e' in vista e si ferma quando
	// esce: ne servono diversi per pagina e pesano parecchio. Chi chiede meno
	// movimento non lo vede partire da solo e ha i comandi nativi. Il bottone
	// di pausa permette comunque di fermarlo (e resta fermo).
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('.cb__media').forEach((media) => {
		const video = media.querySelector<HTMLVideoElement>('.cb__video');
		if (!video) return;

		if (reduce) {
			video.controls = true;
			return;
		}

		const btn = media.querySelector<HTMLButtonElement>('.cb__vbtn');
		let fermoDaUtente = false;

		if (btn) {
			btn.hidden = false;
			btn.addEventListener('click', () => {
				fermoDaUtente = !fermoDaUtente;
				btn.toggleAttribute('data-paused', fermoDaUtente);
				btn.setAttribute('aria-label', fermoDaUtente ? 'Riprendi il video' : 'Metti in pausa il video');
				if (fermoDaUtente) video.pause();
				else video.play().catch(() => {});
			});
		}

		new IntersectionObserver(
			([entry]) => {
				if (entry.isIntersecting && !fermoDaUtente) video.play().catch(() => {});
				else video.pause();
			},
			{ threshold: 0.4 }
		).observe(media);
	});
</script>
