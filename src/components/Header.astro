---
import { megaMenu, voceOrari } from '../data/nav';
import { imgSources } from '../lib/img';

// Foto delle tendine (solo desktop): si caricano alla prima apertura, vedi lo script.
const immagini = megaMenu.map((c) => (c.immagine ? imgSources(c.immagine) : null));
---

<header class="hd">
	<div class="hd__bar container">
		<a class="hd__logo" href="/" aria-label="Body Energie - Home"></a>

		<button class="hd__toggle" type="button" aria-label="Apri il menu" aria-expanded="false" aria-controls="hd-nav" data-hd-toggle>
			<span></span><span></span><span></span>
		</button>

		<nav class="hd__nav" id="hd-nav" aria-label="Principale" data-hd-nav>
			<ul class="hd__mega">
				{
					megaMenu.map((colonna, i) => (
						<li class="hd__col" data-hd-col>
							<button class="hd__col-title" type="button" aria-expanded="false" aria-controls={`hd-sub-${i}`}>
								{colonna.titolo}
								<svg class="hd__chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
									<path d="M1 5l4-4 4 4" stroke="currentColor" stroke-width="1.5" fill="none" />
								</svg>
							</button>
							<div class="hd__panel" id={`hd-sub-${i}`}>
								<ul class="hd__list">
									{colonna.voci.map((voce, j) => (
										<li style={`--i:${j}`}>
											<a href={voce.href}>{voce.label}</a>
										</li>
									))}
								</ul>
								{immagini[i] && (
									<div class="hd__thumb" aria-hidden="true">
										<img data-src={immagini[i]!.src} data-srcset={immagini[i]!.srcset} sizes="300px" alt="" width="300" height="300" decoding="async" />
										<span class="hd__thumb-title">{colonna.titolo}</span>
									</div>
								)}
							</div>
						</li>
					))
				}
				<li class="hd__col hd__col--link">
					<a class="hd__col-title hd__col-link" href={voceOrari.href} aria-current={Astro.url.pathname.startsWith(voceOrari.href) ? 'page' : undefined}>
						{voceOrari.label}
					</a>
				</li>
			</ul>
			<div class="hd__actions">
				<button
					class="btn btn--outline hd__cta hd__cta--contact"
					type="button"
					data-open-contact
					data-interest="informazioni"
				>
					Contattaci
				</button>
				<button class="btn hd__cta hd__cta--primary" type="button" data-open-contact data-interest="abbonamento">
					I nostri abbonamenti
				</button>
			</div>
		</nav>
	</div>
</header>

<script>
	// @ts-nocheck — script vanilla per il browser: gli elementi della pagina ci sono sempre, i tipi DOM generici qui danno solo falsi errori
	const toggle = document.querySelector('[data-hd-toggle]');
	const nav = document.querySelector('[data-hd-nav]');
	const impostaMenu = (aperto) => {
		nav?.classList.toggle('hd__nav--aperto', aperto);
		toggle?.setAttribute('aria-expanded', aperto ? 'true' : 'false');
		toggle?.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
		document.documentElement.classList.toggle('hd-lock', aperto);
	};
	toggle?.addEventListener('click', () => impostaMenu(!nav?.classList.contains('hd__nav--aperto')));
	// Si chiude con un tap su un link o sul bottone contatti, con Esc o
	// tornando a una larghezza desktop.
	nav?.addEventListener('click', (e) => {
		// I titoli delle colonne sono bottoni (aprono il sottomenu su desktop): non chiudono il pannello.
		if (e.target instanceof Element && e.target.closest('a, button:not(.hd__col-title)')) impostaMenu(false);
	});
	document.addEventListener('keydown', (e) => e.key === 'Escape' && impostaMenu(false));
	window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && impostaMenu(false));

	// Mega-menu desktop raggiungibile da tastiera e da touch: col mouse si apre
	// al passaggio (solo CSS), il titolo e' un bottone per Invio/Spazio/tocco.
	// Esc chiude e riporta il focus sul titolo.
	const colonne = Array.from(document.querySelectorAll('[data-hd-col]'));
	const impostaColonna = (col, aperta) => {
		col.classList.toggle('is-open', aperta);
		col.querySelector('.hd__col-title')?.setAttribute('aria-expanded', String(aperta));
	};
	const chiudiColonne = (tranne) => colonne.forEach((c) => c !== tranne && impostaColonna(c, false));
	colonne.forEach((col) => {
		col.querySelector('.hd__col-title')?.addEventListener('click', (e) => {
			// Un clic di mouse arriva con il menu gia' aperto dal passaggio.
			if (e.pointerType === 'mouse') return;
			const aperta = !col.classList.contains('is-open');
			chiudiColonne(col);
			impostaColonna(col, aperta);
		});
		col.addEventListener('focusout', (e) => {
			if (!col.contains(e.relatedTarget)) impostaColonna(col, false);
		});
	});
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const aperta = colonne.find((c) => c.classList.contains('is-open'));
		if (!aperta) return;
		impostaColonna(aperta, false);
		aperta.querySelector('.hd__col-title')?.focus();
	});
	document.addEventListener('click', (e) => {
		if (!e.target.closest('[data-hd-col]')) chiudiColonne();
	});

	// Tendine desktop. Si aprono tutte nello stesso punto, sotto il menu, e ne hanno la larghezza:
	// qui si misura il menu (dal primo all'ultimo titolo) e si imposta --px (distanza dal bordo
	// sinistro del titolo) e --pw (larghezza) di ogni pannello. Le foto (tre per pagina) si
	// caricano quando il browser e' inattivo o, al piu' tardi, alla prima apertura.
	const desktop = () => matchMedia('(min-width: 900.02px)').matches;
	const mega = document.querySelector('.hd__mega');
	const misuraPannelli = () => {
		if (!mega || !desktop()) return;
		const m = mega.getBoundingClientRect();
		colonne.forEach((col) => {
			const pannello = col.querySelector('.hd__panel');
			if (!pannello) return;
			pannello.style.setProperty('--px', m.left - col.getBoundingClientRect().left + 'px');
			pannello.style.setProperty('--pw', m.width + 'px');
		});
	};
	const caricaFoto = (col) => {
		const img = col.querySelector('.hd__thumb img');
		if (!img || img.getAttribute('src')) return;
		if (img.dataset.srcset) img.srcset = img.dataset.srcset;
		img.src = img.dataset.src;
	};
	colonne.forEach((col) =>
		['pointerenter', 'focusin'].forEach((ev) =>
			col.addEventListener(ev, () => {
				if (!desktop()) return;
				misuraPannelli();
				caricaFoto(col);
			})
		)
	);
	misuraPannelli();
	window.addEventListener('resize', misuraPannelli);
	document.fonts?.ready.then(misuraPannelli);
	window.addEventListener('load', () => {
		misuraPannelli();
		if (!desktop()) return;
		(window.requestIdleCallback || ((f) => setTimeout(f, 1500)))(() => colonne.forEach(caricaFoto));
	});

	// L'header cambia colore (sfondo a gradiente, voci col colore che
	// prima era lo sfondo) appena si inizia a scorrere la pagina.
	const header = document.querySelector('.hd');
	const aggiornaScroll = () => header?.classList.toggle('hd--scrolled', window.scrollY > 10);
	aggiornaScroll();
	window.addEventListener('scroll', aggiornaScroll, { passive: true });
</script>

<style>
	.hd {
		/* Sfondo bianco leggermente trasparente sempre (anche in cima):
		   logo e simbolo del menu' sono neri e si perderebbero sulle
		   sezioni scure. */
		--hd-h: var(--header-h);
		border-bottom: 1px solid var(--border);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 40;
	}

	/* Lo sfondo sta in un pseudo-elemento: backdrop-filter sull'header stesso
	   farebbe da contenitore al menu' mobile (position: fixed) e lo
	   ridurrebbe all'altezza della barra. */
	.hd::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgba(255, 255, 255, 0.82);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}

	.hd__col-title,
	.hd__chevron {
		color: var(--text);
	}

	.hd__col + .hd__col::before {
		background: var(--accent);
	}

	.hd__chevron {
		margin-left: 4px;
		vertical-align: middle;
	}

	.hd__actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.hd__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 8px;
	}

	.hd__logo {
		text-decoration: none;
		display: block;
		-webkit-tap-highlight-color: transparent;
		width: 113px;
		height: 44px;
		background-image: url('/wp-content/uploads/2025/10/Logo-Body-Energie-header.png');
		background-repeat: no-repeat;
		background-position: left center;
		background-size: contain;
	}

	.hd__toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		padding: 8px;
	}

	.hd__toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--text);
	}

	.hd__nav {
		display: flex;
		align-items: center;
		flex: 1;
	}

	/* Margini automatici sui due lati: il menu resta sempre esattamente a
	   meta' strada tra il logo e i bottoni, qualunque sia la loro larghezza. */
	.hd__mega {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 20px;
		margin-inline: auto;
		padding: 0;
	}

	.hd__col {
		position: relative;
	}

	.hd__col + .hd__col::before {
		content: '';
		position: absolute;
		left: -10px;
		top: 50%;
		transform: translateY(-50%);
		width: 2px;
		height: 22px;
	}

	.hd__col-title {
		padding: 0;
		border: 0;
		background: none;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		cursor: default;
	}

	/* Voce senza sottomenu (Orari): un collegamento con lo stesso aspetto dei titoli. */
	.hd__col-link {
		display: inline-block;
		line-height: normal;
		color: var(--text);
		text-decoration: none;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.hd__col-link:hover,
	.hd__col-link[aria-current='page'] {
		color: var(--accent);
	}

	.hd__col-title:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 4px;
		border-radius: 4px;
	}

	/* Pannello del sottomenu: elenco + foto (la foto solo su desktop). Nascosto finche' non si apre. */
	.hd__col > .hd__panel {
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 220px;
		background: var(--bg);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: 0.15s ease;
	}

	.hd__col:hover > .hd__panel,
	.hd__col.is-open > .hd__panel {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.hd__list {
		list-style: none;
		margin: 0;
		padding: 12px;
	}

	.hd__list li a {
		display: block;
		padding: 6px 4px;
		color: var(--text);
		text-decoration: none;
		font-size: var(--text-sm);
	}

	.hd__list li a:hover {
		color: var(--accent);
	}

	.hd__thumb {
		display: none;
	}

	.hd__cta {
		white-space: normal;
		font-size: 14px;
		padding: 10px 16px;
		text-align: center;
	}

	.hd__cta--contact {
		--btn-border: var(--text);
		--btn-hover-text: var(--accent);
	}

	/* ---- Menu a tendina desktop ----
	   Pannello a due parti, come sul vecchio sito: elenco a sinistra e foto con il titolo della
	   categoria a destra. Stesso colore (e sfocatura) dell'header, attaccato al suo bordo
	   inferiore, angoli bassi arrotondati. Le voci hanno lo stesso font dei titoli del menu.
	   Solo desktop: il menu mobile ha le sue regole. */
	@media (min-width: 900.02px) {
		/* Titolo aperto: arancione e freccia verso il basso. */
		.hd__col:hover > .hd__col-title,
		.hd__col.is-open > .hd__col-title,
		.hd__col:hover > .hd__col-title .hd__chevron,
		.hd__col.is-open > .hd__col-title .hd__chevron {
			color: var(--accent);
		}

		.hd__chevron {
			transition: transform 0.3s var(--ease-out-crit);
		}

		.hd__col:hover .hd__chevron,
		.hd__col.is-open .hd__chevron {
			transform: rotate(180deg);
		}

		/* Ponte invisibile sui 24px tra titolo e pannello: il mouse puo' scendere senza chiuderlo. */
		.hd__col::after {
			content: '';
			position: absolute;
			left: -12px;
			right: -12px;
			top: 100%;
			height: 24px;
		}

		/* Il titolo sta 24px sopra il bordo inferiore dell'header: il pannello parte da li'.
		   Tutte le tendine si aprono nello stesso punto, sotto il menu, e ne hanno la larghezza
		   (dal primo all'ultimo titolo): --px e --pw li imposta lo script a ogni misura. */
		.hd__col > .hd__panel {
			top: calc(100% + 24px);
			left: var(--px, 0px);
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			width: var(--pw, 600px);
			min-width: 0;
			min-height: 300px;
			padding: 0;
			overflow: hidden;
			border: 0;
			border-radius: 0 0 30px 30px;
			background: rgba(255, 255, 255, 0.82);
			-webkit-backdrop-filter: blur(10px);
			backdrop-filter: blur(10px);
			box-shadow: 0 22px 36px -14px rgba(0, 0, 0, 0.3);
			transform: translateY(10px);
			transition: opacity 0.2s ease, transform 0.35s var(--ease-out-crit), visibility 0s 0.35s;
		}

		.hd__col:hover > .hd__panel,
		.hd__col.is-open > .hd__panel {
			transform: none;
			transition: opacity 0.2s ease, transform 0.35s var(--ease-out-crit), visibility 0s;
		}

		.hd__list {
			align-self: center;
			padding: 18px 12px 22px;
		}

		.hd__list li {
			opacity: 0;
			transform: translateY(8px);
			transition: opacity 0.2s ease, transform 0.3s var(--ease-out-crit);
		}

		.hd__col:hover > .hd__panel li,
		.hd__col.is-open > .hd__panel li {
			opacity: 1;
			transform: none;
			transition-delay: calc(var(--i, 0) * 35ms + 60ms);
		}

		/* Stesso font dei titoli del menu (Montserrat 600, 16px), centrato, in arancione. */
		.hd__list li a {
			padding: 13px 16px;
			border-radius: 12px;
			color: var(--accent-hover);
			font-family: var(--font-heading);
			font-size: 16px;
			font-weight: 600;
			text-align: center;
			transition: background 0.2s ease, color 0.2s ease;
		}

		.hd__list li a:hover,
		.hd__list li a:focus-visible {
			color: var(--accent);
			background: var(--accent-tint);
		}

		.hd__list li a:focus-visible {
			outline: 3px solid var(--accent);
			outline-offset: -3px;
		}

		/* Foto con il nome della categoria sopra, come nel vecchio menu. */
		.hd__thumb {
			position: relative;
			display: block;
			overflow: hidden;
			background: var(--bg-dark);
		}

		.hd__thumb img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.hd__thumb::after {
			content: '';
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.3);
		}

		.hd__thumb-title {
			position: absolute;
			inset: 0;
			z-index: 1;
			display: grid;
			place-items: center;
			padding: 0 14px;
			text-align: center;
			font-family: var(--font-heading);
			font-size: clamp(1.5rem, 2.2vw, 2rem);
			font-weight: 900;
			line-height: 0.95;
			text-transform: uppercase;
			color: var(--accent-secondary);
			text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
		}
	}

	@media (min-width: 900.02px) and (prefers-reduced-motion: reduce) {
		.hd__col > .hd__panel,
		.hd__list li,
		.hd__chevron {
			transition: none;
		}

		.hd__list li {
			opacity: 1;
			transform: none;
		}
	}

	/* (900.02px e non 901px: a larghezze frazionarie tra 900 e 901 nessuna delle due regole si applicherebbe.)
	   Desktop stretto: con la voce Orari il menu non ci sta ai valori pieni. Spazi e corpo
	   un po' piu' piccoli e i pulsanti restano su una riga, cosi' l'header non cresce. */
	@media (min-width: 900.02px) and (max-width: 1100px) {
		.hd__mega {
			gap: 14px;
		}

		.hd__col + .hd__col::before {
			left: -8px;
		}

		.hd__col-title {
			font-size: 15px;
			white-space: nowrap;
		}

		.hd__actions {
			flex-wrap: nowrap;
			gap: 8px;
		}

		.hd__cta {
			white-space: nowrap;
			font-size: 13px;
			padding: 9px 12px;
		}
	}

	/* Ancora piu' stretto, appena sopra la soglia dell'hamburger. */
	@media (min-width: 900.02px) and (max-width: 960px) {
		.hd__mega {
			gap: 10px;
		}

		.hd__col + .hd__col::before {
			left: -6px;
		}

		.hd__col-title {
			font-size: 14px;
		}

		.hd__cta {
			font-size: 12px;
			padding: 8px 10px;
		}
	}

	@media (max-width: 900px) {
		.hd__toggle {
			display: flex;
			position: relative;
			z-index: 2;
			width: 44px;
			height: 44px;
			align-items: center;
			justify-content: center;
			margin-right: -8px;
			-webkit-tap-highlight-color: transparent;
		}

		/* Le tre linee diventano una X */
		.hd__toggle span {
			position: absolute;
			width: 24px;
			transition: transform 0.35s var(--ease-out-crit), opacity 0.2s ease;
		}
		.hd__toggle span:nth-child(1) { transform: translateY(-7px); }
		.hd__toggle span:nth-child(3) { transform: translateY(7px); }
		.hd__toggle[aria-expanded='true'] span:nth-child(1) { transform: rotate(45deg); }
		.hd__toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
		.hd__toggle[aria-expanded='true'] span:nth-child(3) { transform: rotate(-45deg); }

		/* Pannello a tutto schermo sotto la barra */
		.hd__nav {
			position: fixed;
			inset: var(--hd-h) 0 0 0;
			z-index: 1;
			flex: none;
			flex-direction: column;
			align-items: stretch;
			justify-content: space-between;
			gap: 20px;
			padding: 20px 24px max(24px, env(safe-area-inset-bottom));
			overflow-y: auto;
			overscroll-behavior: contain;
			color: var(--text-on-dark);
			background:
				radial-gradient(120% 60% at 100% 0%, rgba(236, 116, 15, 0.22), transparent 60%),
				var(--bg-dark);
			opacity: 0;
			visibility: hidden;
			/* Da chiuso il pannello copre tutta la pagina: non deve intercettare i tocchi. */
			pointer-events: none;
			transform: translateY(-12px);
			transition: opacity 0.3s ease, transform 0.45s var(--ease-out-crit), visibility 0s 0.45s;
		}

		.hd__nav.hd__nav--aperto {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			transform: none;
			transition: opacity 0.3s ease, transform 0.45s var(--ease-out-crit), visibility 0s;
		}

		:global(html.hd-lock) {
			overflow: hidden;
		}

		.hd__mega {
			flex-direction: column;
			align-items: stretch;
			gap: 18px;
			margin: 0;
			counter-reset: sezione;
		}

		.hd__col {
			counter-increment: sezione;
			padding-top: 14px;
			border-top: 1px solid rgba(255, 255, 255, 0.14);
		}

		.hd__col + .hd__col::before {
			display: none;
		}

		.hd__col-title {
			display: flex;
			width: 100%;
			text-align: left;
			align-items: baseline;
			gap: 12px;
			margin-bottom: 8px;
			color: var(--text-on-dark);
			font-size: 1.35rem;
			font-weight: 700;
			letter-spacing: -0.01em;
		}

		/* Voce senza sottomenu: freccia a destra, come un invito ad aprire la pagina. */
		.hd__col-link {
			display: flex;
			/* area di tocco di almeno 44px */
			padding-block: 9px;
			color: var(--text-on-dark);
		}

		/* Nessun elenco sotto: niente spazio da riservargli. */
		.hd__col--link .hd__col-title {
			margin-bottom: 0;
		}

		.hd__col-link::after {
			content: '→';
			margin-left: auto;
			color: var(--accent);
		}

		.hd__col-title::before {
			content: counter(sezione, decimal-leading-zero);
			color: var(--accent);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.08em;
		}

