---
import { megaMenu, voceOrari } from '../data/nav';
import { site, social, legalLinks, mapsEmbedSrc, mapsDirectionsUrl } from '../data/site';
import { orari, orariEstivi } from '../data/orari';
import { stats, formattaNumero } from '../data/stats';
import Img from './Img.astro';

// Stesso contenuto reale del footer originale (post ID 1068 di Elementor) e stessi
// loghi partner, riorganizzato in: CTA principale, "dove siamo" con mappa,
// colonne di link, fascia loghi, riga finale con i documenti legali.
// La sezione "dove siamo" sostituisce con una mappa statica il widget a
// pagamento Elfsight Store Locator del sito originale (stessi dati reali:
// indirizzo, telefono, email), per non introdurre un nuovo servizio a pagamento.
// Sede, social, documenti, orari e numeri stanno in src/data/.
const address = site.address;

// Stessi loghi del sito originale, ritagliati dai margini vuoti (in
// public/images/loghi/) per poterli mostrare tutti alla stessa scala.
const partner = [
	{ src: '/images/loghi/asi.png', alt: 'ASI' },
	{ src: '/images/loghi/coni.png', alt: 'CONI' },
	{ src: '/images/loghi/anif.png', alt: 'ANIF' },
	{ src: '/images/loghi/csen.png', alt: 'CSEN' },
	{ src: '/images/loghi/technogym.png', alt: 'Technogym' },
	{ src: '/images/loghi/mediolanum.png', alt: 'Banca Mediolanum' },
	{ src: '/images/loghi/group-cycling.png', alt: 'Group Cycling' },
	{ src: '/images/loghi/peak-pilates.png', alt: 'Peak Pilates' },
	{ src: '/images/loghi/les-mills.png', alt: 'Les Mills' },
	{ src: '/images/loghi/ekoi.png', alt: 'EKOI' },
	{ src: '/images/loghi/zumba.png', alt: 'Zumba Fitness' },
];

// I 4 loghi della striscia "Coesione" del sito originale, separati: per i
// progetti cofinanziati vanno mostrati a colori e sempre visibili, e
// rimandano alla pagina del contributo come la striscia originale.
const loghiCofinanziamento = [
	{ src: '/images/loghi/coesione-italia.png', alt: 'Coesione Italia 21-27 Veneto' },
	{ src: '/images/loghi/unione-europea.png', alt: "Cofinanziato dall'Unione europea" },
	{ src: '/images/loghi/repubblica-italiana.png', alt: 'Repubblica Italiana' },
	{ src: '/images/loghi/regione-veneto.png', alt: 'Regione del Veneto' },
];

const info = [
	{ href: '/orari', label: 'Planning settimanale' },
	// Sul vecchio sito era un modulo (Typeform), non una pagina: apre il modulo contatti.
	{ interesse: 'abbonamento', label: 'Abbonamenti' },
	// Nel sito originale il bottone "Posizioni aperte" non aveva una destinazione: scrive all'email del centro.
	{ href: `mailto:${site.email}?subject=${encodeURIComponent('Candidatura spontanea')}`, label: 'Lavora con noi' },
];

// Stessi numeri della sezione contatori della home: qui fanno da prova sociale
// accanto alla CTA.
const provaSociale = stats.map((x) => ({ numero: formattaNumero(x.target) + x.suffisso, etichetta: x.breve }));

const colonneFoto = [
	[
		'/wp-content/uploads/2025/12/Body-Energie-Ambienti-57-scaled.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Azioni-64-scaled.jpg',
		'/wp-content/uploads/2025/12/Body-Energie-Piscina-2-scaled.jpg',
	],
	[
		'/wp-content/uploads/2025/08/IMG-20210528-WA0046.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Azioni-62-scaled.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Ambienti-70-scaled.jpg',
	],
	[
		'/wp-content/uploads/2025/11/Body-Energie-Ambienti-25-scaled.jpg',
		'/wp-content/uploads/2025/11/Body-Energie-Ambienti-48-scaled.jpg',
		'/wp-content/uploads/2025/12/Body-Energie-Piscina-7-scaled.jpg',
	],
];
---

<footer class="ft">
	<section class="cta-final" aria-labelledby="cta-final-title">
		<div class="cta-final__content">
			<p class="pill pill--dark cta-final__eyebrow" data-anim="pop">Inizia oggi!</p>
			<h2 class="display-title cta-final__title" id="cta-final-title" data-anim="up" data-anim-delay="120">
				Prova <span class="cta-final__title-accent">ora</span><br />il nostro centro
			</h2>
			<p class="cta-final__lead" data-anim="up" data-anim-delay="240">Lascia i tuoi dati: ti ricontattiamo noi per organizzare la tua prova.</p>

			<ul class="cta-final__proof">
				{
					provaSociale.map((p, i) => (
						<li data-anim="up" data-anim-delay={String(360 + i * 100)}>
							<strong>{p.numero}</strong>
							<span>{p.etichetta}</span>
						</li>
					))
				}
			</ul>

			<div class="cta-final__actions" data-anim="up" data-anim-delay="760">
				<button class="btn btn--light btn--lg cta-final__btn" type="button" data-open-contact data-interest="prova-gratuita">
					Attiva ora <span class="cta-final__btn-arrow" aria-hidden="true">→</span>
				</button>
			</div>
		</div>

		<div class="cta-final__wall" aria-hidden="true" data-anim="from-right">
			{
				colonneFoto.map((colonna, i) => (
					<div class={`cta-final__col ${i === 1 ? 'cta-final__col--down' : ''}`}>
						<div class="cta-final__track">
							{[...colonna, ...colonna].map((src) => (
								<Img src={src} sizes="(max-width: 900px) 30vw, 14vw" />
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="find-us" aria-labelledby="find-us-title">
		<div class="find-us__content">
			<p class="pill find-us__eyebrow" data-anim="pop">Dove siamo</p>
			<h2 class="display-title find-us__title" id="find-us-title" data-anim="up" data-anim-delay="120">
				Vieni a <span class="find-us__title-accent">trovarci</span>
			</h2>

			<div class="find-us__orari" style={`--righe:${1 + Math.max(...orari.map((o) => o.righe.length))}`}>
				{
					orari.map((o, i) => (
						<div class="find-us__orari-card" data-anim="up" data-anim-delay={String(240 + i * 120)}>
							<p class="find-us__label">{o.titolo}</p>
							<dl class="find-us__orari-list">
								{o.righe.map((r) => (
									<div>
										<dt>{r.giorni}</dt>
										<dd>{r.ore}</dd>
									</div>
								))}
							</dl>
						</div>
					))
				}
			</div>

			<ul class="find-us__contatti" data-anim="up" data-anim-delay="420">
				<li>
					<span>Indirizzo</span>
					<a href={mapsDirectionsUrl} target="_blank" rel="noopener">{address}</a>
				</li>
				<li>
					<span>Telefono</span>
					<a href={site.phoneHref}>{site.phone}</a>
				</li>
				<li>
					<span>Email</span>
					<a href={`mailto:${site.email}`}>{site.email}</a>
				</li>
			</ul>

			<div class="find-us__cta" data-anim="up" data-anim-delay="480">
				<a class="btn btn--outline" href={voceOrari.href}>Orari corsi</a>
				<button class="btn" type="button" data-open-contact data-interest="informazioni">Contattaci</button>
			</div>
		</div>

		<div class="find-us__map" data-anim="from-left">
			<iframe
				src={mapsEmbedSrc}
				title={`Mappa - Body Energie, ${address}`}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>
	</section>

	<div class="ft-main">
		<div class="ft-brand" data-anim="up">
			<img
				class="ft-brand__logo"
				src="/images/logo-body-energie-chiaro.png"
				alt="Body Energie"
				height="40"
			/>
			<p class="ft-brand__blurb">
				Body Energie è il tuo punto di riferimento per fitness, benessere e sport a Villafranca di Verona. Attrezzature
				all'avanguardia, corsi per ogni livello e un'offerta completa per adulti e bambini.
			</p>
			<div class="ft-social">
				{
					social.map((s) => (
						<a class="ft-social__btn" href={s.href} target="_blank" rel="noopener" aria-label={`Body Energie su ${s.label}`}>
							<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={s.icon} />
						</a>
					))
				}
			</div>
		</div>

		{
			megaMenu.map((colonna, i) => (
				<nav class="ft-col" aria-label={colonna.titolo} data-anim="up" data-anim-delay={String(80 + i * 80)}>
					<p class="ft-heading">{colonna.titolo}</p>
					<ul class="ft-links">
						{colonna.voci.map((voce) => (
							<li>
								<a href={voce.href}>{voce.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}

		<div class="ft-col" data-anim="up" data-anim-delay="320">
			<p class="ft-heading">Info</p>
			<ul class="ft-links">
				{
					info.map((l) => (
						<li>
							{l.interesse ? (
								<button type="button" data-open-contact data-interest={l.interesse}>
									{l.label}
								</button>
							) : (
								<a href={l.href}>{l.label}</a>
							)}
						</li>
					))
				}
			</ul>
			<details class="ft-estivi">
				<summary>Orari estivi</summary>
				{
					orariEstivi.map((blocco) => (
						<>
							<p class="ft-estivi__title">{blocco.titolo}</p>
							<ul>
								{blocco.righe.map((r) => (
									<li>
										{r.giorni}: {r.ore}
									</li>
								))}
							</ul>
						</>
					))
				}
			</details>
		</div>
	</div>

	<section class="ft-loghi" aria-label="Partner e istituzioni">
		<p class="ft-heading">Partner e istituzioni</p>
		<ul class="ft-tiles">
			{
				partner.map((p, i) => (
					<li class="ft-tile" data-anim="up" data-anim-delay={String(i * 50)}>
						<img src={p.src} alt={p.alt} loading="lazy" />
					</li>
				))
			}
			{
				loghiCofinanziamento.map((l, i) => (
					<li class="ft-tile" data-anim="up" data-anim-delay={String((partner.length + i) * 50)}>
						<a href="/contributo-regione-veneto">
							<img src={l.src} alt={l.alt} loading="lazy" />
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<div class="ft-bottom">
		<div class="ft-bottom__row">
			<p>© {new Date().getFullYear()} {site.legalName} · P.IVA {site.vat} · {address}</p>
			<ul class="ft-legal">
				{
					legalLinks.map((l) => (
						<li>
							<a href={l.href} target={l.esterno ? '_blank' : undefined} rel={l.esterno ? 'noopener' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="ft-bottom__row">
			<p>Sito web per la Propaganda dell'Attività Fisica Sportiva Dilettantistica</p>
			<div class="ft-firma">
				<span>Powered by</span>
				<a href="https://ready2digital.it" target="_blank" rel="noopener">
					<img src="/wp-content/uploads/2026/04/R2D.png" alt="Ready 2 Digital" height="16" />
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.ft {
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.ft h2 {
		color: var(--text-on-dark);
	}

	/* --- CTA principale del sito: testo a sinistra, muro di foto a destra --- */
	/* Alta esattamente una schermata, al netto dell'header fisso (--screen-h). */
	.cta-final {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		height: var(--screen-h);
		min-height: 560px;
		overflow: hidden;
		background: var(--accent);
		color: var(--text);
	}

	.cta-final__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 60px 72px 60px var(--gutter);
	}

	.cta-final__eyebrow {
		align-self: flex-start;
		margin: 0 0 20px;
	}

	.ft .cta-final__title {
		color: var(--text);
	}

	.cta-final__title-accent {
		color: var(--text-on-dark);
		font-style: italic;
	}

	.cta-final__lead {
		max-width: 30rem;
		margin: 24px 0 0;
		font-size: var(--text-md);
		line-height: 1.5;
	}

	.cta-final__proof {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		margin: 28px 0 0;
		padding: 0;
		list-style: none;
	}

	.cta-final__proof li {
		display: flex;
		flex-direction: column;
		padding: 0 24px;
		border-left: 1px solid var(--text);
	}

	.cta-final__proof li:first-child {
		padding-left: 0;
		border-left: none;
	}

	.cta-final__proof strong {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.4vw, 2.25rem);
		font-weight: 900;
		line-height: 1;
		color: var(--text-on-dark);
	}

	.cta-final__proof span {
		margin-top: 6px;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.cta-final__actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px 28px;
		margin-top: 32px;
	}

	/* Colore e taglia: .btn--light .btn--lg (globali). Qui solo freccia e anello pulsante. */
	.cta-final__btn {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		letter-spacing: 0.04em;
		animation: cta-pulse 2.4s ease-out infinite;
	}

	.cta-final__btn-arrow {
		display: inline-block;
		transition: transform 0.3s var(--ease-out-crit);
	}

	.cta-final__btn:hover .cta-final__btn-arrow {
		transform: translateX(6px);
	}

	/* Anello che si espande intorno al bottone: attira l'occhio sulla CTA
	   senza muovere il bottone stesso. */
	@keyframes cta-pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.55);
		}
		70%,
		100% {
			box-shadow: 0 0 0 16px rgba(255, 255, 255, 0);
		}
	}

	/* Tre colonne verticali di foto: quella centrale scorre al contrario.
	   La maschera le fa sfumare nell'arancione in alto e in basso. */
	.cta-final__wall {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
		padding-right: var(--gutter);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(180deg, transparent, #000 12%, #000 88%, transparent);
	}

	.cta-final__track {
		animation: cta-scroll-up 38s linear infinite;
	}

	.cta-final__col--down .cta-final__track {
		animation-name: cta-scroll-down;
	}

	.cta-final__wall:hover .cta-final__track {
		animation-play-state: paused;
	}

	.cta-final__track img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		margin-bottom: 14px;
		object-fit: cover;
		border-radius: 14px;
		box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
	}

	@keyframes cta-scroll-up {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-50%);
		}
	}

	@keyframes cta-scroll-down {
		from {
			transform: translateY(-50%);
		}
		to {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta-final__btn,
		.cta-final__track {
			animation: none;
		}
	}

	/* Mobile: eyebrow, titolo, testo e numeri, poi le foto (due colonne, piu' grandi) e
	   il pulsante SOTTO le foto. Il contenitore del testo e' "display: contents" cosi'
	   gli elementi si possono riordinare insieme al muro di foto. La sezione cresce con
	   il contenuto (prima era alta una schermata fissa e le foto restavano minuscole). */
	@media (max-width: 900px) {
		.cta-final {
			display: flex;
			flex-direction: column;
			height: auto;
			min-height: 0;
			padding: 36px var(--gutter) 32px;
		}

		.cta-final__content {
			display: contents;
		}

		.cta-final__eyebrow {
			order: 1;
		}

		.ft .cta-final__title {
			order: 2;
		}

		.cta-final__lead {
			order: 3;
			margin-top: 16px;
		}

		.cta-final__proof {
			order: 4;
			grid-template-columns: repeat(2, auto);
			row-gap: 16px;
			margin-top: 20px;
		}

		.cta-final__proof li:nth-child(3) {
			padding-left: 0;
			border-left: none;
		}

		.cta-final__wall {
			order: 5;
			grid-template-columns: repeat(2, 1fr);
			height: clamp(300px, 52svh, 420px);
			margin-top: 24px;
			padding-right: 0;
		}

		.cta-final__col:nth-child(3) {
			display: none;
		}

		.cta-final__actions {
			order: 6;
			margin-top: 24px;
		}
	}

	@media (max-width: 560px) {
		.cta-final__btn {
			width: 100%;
			justify-content: center;
		}
	}

	/* --- "Dove siamo": mappa + info + cta --- */
	/* Stessa struttura della CTA sopra: alta una schermata (al netto
	   dell'header fisso), ma speculare: mappa a sinistra, testo a destra,
	   su fondo bianco. Nel codice il testo resta prima della mappa, cosi'
	   su mobile sta sopra. */
	.find-us {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		/* Alta una schermata, ma cresce se il contenuto (orari, contatti, pulsanti) e' piu' alto. */
		min-height: max(var(--screen-h), 560px);
		background: var(--bg);
		color: var(--text);
	}

	.find-us__content {
		grid-column: 2;
		grid-row: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 60px var(--gutter) 60px 72px;
	}

	.find-us__eyebrow {
		align-self: flex-start;
		margin: 0 0 20px;
	}

	.ft .find-us__title {
		color: var(--text);
	}

	.find-us__title-accent {
		color: var(--accent);
		font-style: italic;
	}

	.find-us__map {
		grid-column: 1;
		grid-row: 1;
		position: relative;
		margin: 60px 0 60px var(--gutter);
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.find-us__map iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* Due card affiancate (stesso crema dell'header), una riga per fascia
	   oraria: giorni a sinistra, orario a destra in grassetto. */
	.find-us__orari {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin-top: 36px;
	}

	/* Le righe delle due card stanno sulle stesse righe della griglia (subgrid): se in una
	   un testo va a capo, l'altra si allunga uguale e le righe restano parallele. */
	.find-us__orari {
		column-gap: 16px;
		row-gap: 0;
	}

	.find-us__orari-card {
		display: grid;
		grid-template-rows: subgrid;
		grid-row: span var(--righe);
		padding: 24px 26px;
		border-radius: var(--radius-lg);
		background: var(--bg-alt);
	}

	.find-us__label {
		margin: 0 0 10px;
		font-family: var(--font-heading);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: var(--text-xs);
		font-weight: 800;
		color: var(--accent);
	}

	.find-us__orari-list {
		display: contents;
	}

	.find-us__orari-list div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		padding: 12px 0;
		border-bottom: 1px solid var(--border-strong);
	}

	.find-us__orari-list div:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.find-us__orari-list dt {
		font-size: var(--text-sm);
		color: rgba(0, 0, 0, 0.7);
	}

	.find-us__orari-list dd {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--text);
	}

	/* Indirizzo, telefono ed email: visibili e cliccabili (mappa, chiamata, posta). */
	.find-us__contatti {
		display: grid;
		gap: 10px;
		margin: 28px 0 0;
