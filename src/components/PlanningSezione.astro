---
/*
 * Orari di una sezione di una scheda, a scomparsa: sotto il blocco che parla di un corso (es. Acqua
 * Gym, Yoga) c'e' una barra "Orari · 7 lezioni a settimana" con il nome del corso, che si apre al
 * tocco e mostra, giorno per giorno, a che ora si fa. Chiusa occupa una riga, cosi' chi scorre solo
 * per leggere non si trova davanti un planning intero.
 * L'orario completo, con tab e filtri, e' sulla pagina /orari (link "Vedi orario completo").
 *
 * Non ha dati suoi: le lezioni di ogni sezione si ricavano da src/data/orari-schede.json (quale
 * lezione appartiene a quale blocco di quale scheda) e gli orari da src/data/orario-corsi.json,
 * lo stesso file dell'orario completo: quando cambia l'orario, cambiano anche le schede.
 * Se la sezione non ha lezioni nel planning (servizi, Technogym Ride) non mostra nulla.
 * E' un <details>: si apre e si chiude anche da tastiera e funziona senza JavaScript.
 */
import schede from '../data/orari-schede.json';
import { giorniDelPlanning } from '../lib/planning';

interface Props {
	/** Indirizzo della scheda (es. "acqua"). */
	slug: string;
	/** Posizione del blocco nella scheda (0 = primo). */
	blocco: number;
	/** Nome della sezione per il titolo (titolo del blocco o nome della pagina). */
	titolo: string;
	/** Fondo del blocco: sull'arancione la barra e' un riquadro nero. */
	tone?: 'dark' | 'arancio';
}

const { slug, blocco, titolo, tone = 'dark' } = Astro.props;

const lezioni = Object.entries(schede as Record<string, { slug: string; blocco?: number }>)
	.filter(([, v]) => v.slug === slug && (v.blocco ?? 0) === blocco)
	.map(([nome]) => nome);

// Solo i giorni con lezioni; ogni giorno e' una riga, le lezioni sono "caselle" in ordine di orario.
const giorni = giorniDelPlanning(lezioni)
	.map((g) => ({ ...g, voci: g.fasce.flatMap(([ora, voci]) => voci.map((v) => ({ ...v, ora }))) }))
	.filter((g) => g.voci.length > 0);
const totale = giorni.reduce((n, g) => n + g.voci.length, 0);

// Con piu' lezioni nella stessa sezione (Reformer e Reformer Intro 30') l'orario dice anche quale:
// la lezione "base" (il nome piu' corto) resta senza etichetta, l'altra mostra la differenza.
const base = [...lezioni].sort((a, b) => a.length - b.length)[0] ?? '';
const etichetta = (nome: string) => (lezioni.length > 1 && nome !== base ? nome.replace(base, '').trim() : '');
---

{
	totale > 0 && (
		<div class:list={['plan', `plan--${tone}`]} role="group" aria-label={`Orari ${titolo}`}>
			<details class="plan__acc">
				<summary class="plan__sum">
					<span class="plan__sum-testo">
						<span class="plan__sub">
							Orari · {totale} {totale === 1 ? 'lezione' : 'lezioni'} a settimana
						</span>
						<span class="plan__tit">{titolo}</span>
					</span>
					<span class="plan__chev" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22">
							<path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</span>
				</summary>

				<div class="plan__corpo">
					<ul class="plan__giorni">
						{giorni.map((g) => (
							<li class="plan__giorno" data-giorno={g.id}>
								<span class="plan__nome">
									<span aria-hidden="true">{g.id}</span>
									<span class="sr-only">{g.nome}</span>
								</span>
								<ul class="plan__ore">
									{g.voci.map((v) => (
										<li class="plan__ora">
											<span class="plan__time">{v.ora}</span>
											{(etichetta(v.nome) || v.nuovo) && (
												<span class="plan__lez">
													{etichetta(v.nome)}
													{v.nuovo && <span class="plan__new">New</span>}
												</span>
											)}
										</li>
									))}
								</ul>
							</li>
						))}
					</ul>

					<div class="plan__piede">
						<a class="plan__link" href="/orari">Vedi orario completo</a>
					</div>
				</div>
			</details>
		</div>
	)
}

<style>
	.plan {
		--plan-testo: var(--text-on-dark);
		--plan-bordo: var(--border-on-dark);
		--plan-evid: var(--accent);
		--plan-velo: rgba(255, 255, 255, 0.08);
		--plan-fondo: var(--bg-dark-soft);
		color: var(--plan-testo);
	}

	/* Sull'arancione: la barra e' un riquadro nero (testo bianco, evidenze arancioni). */
	.plan--arancio {
		--plan-fondo: #000;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	.plan__acc {
		border: 1px solid var(--plan-bordo);
		border-radius: var(--radius);
		background: var(--plan-fondo);
		transition: border-color var(--dur-base);
	}

	.plan__acc[open] {
		border-color: var(--plan-evid);
	}

	/* La barra chiusa: etichetta piccola arancione sopra, nome del corso grande sotto, freccia a destra. */
	.plan__sum {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 60px;
		padding: 12px 20px;
		list-style: none;
		cursor: pointer;
	}

	.plan__sum::-webkit-details-marker {
		display: none;
	}

	.plan__sum:focus-visible {
		outline: 3px solid var(--plan-evid);
		outline-offset: 3px;
		border-radius: var(--radius);
	}

	.plan__sum-testo {
		display: grid;
		gap: 4px;
		min-width: 0;
	}

	.plan__sub {
		font-size: var(--text-sm);
		font-weight: 800;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--plan-evid);
	}

	.plan__tit {
		font-family: var(--font-heading);
		font-size: clamp(1.2rem, 4.6vw, 1.6rem);
		line-height: 1.15;
		font-weight: 900;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.plan__chev {
		display: grid;
		place-items: center;
		flex: none;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--plan-velo);
		color: var(--plan-evid);
		transition: transform 0.3s var(--ease-out-crit);
	}

	.plan__acc[open] .plan__chev {
		transform: rotate(180deg);
	}

	.plan__corpo {
		padding: 20px;
		border-top: 1px solid var(--plan-bordo);
	}

	/* Aperto: un giorno per riga (sigla a sinistra), le lezioni come "caselle" con l'orario. */
	.plan__giorni {
		display: grid;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.plan__giorno {
		display: grid;
		grid-template-columns: 3.4rem minmax(0, 1fr);
		align-items: stretch;
		gap: 10px;
		padding: 6px;
		border: 1px solid var(--plan-bordo);
		border-radius: 12px;
	}

	.plan__nome {
		display: grid;
		place-items: center;
		border-radius: 8px;
		background: var(--plan-velo);
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.plan__giorno.is-oggi {
		border-color: var(--plan-evid);
	}

	.plan__giorno.is-oggi .plan__nome {
		background: var(--plan-evid);
		color: var(--text);
	}

	.plan__ore {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.plan__ora {
		flex: 0 1 9rem;
		display: grid;
		gap: 1px;
		padding: 6px 10px;
		border-radius: 8px;
		background: var(--plan-velo);
	}

	.plan__time {
		font-family: var(--font-heading);
		font-size: var(--text-md);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--plan-evid);
	}

	.plan__lez {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.plan__new {
		padding: 1px 7px;
		border-radius: 999px;
		background: var(--plan-evid);
		color: var(--text);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.plan__piede {
		display: flex;
		justify-content: center;
		margin-top: 16px;
	}

	/* "Vedi orario completo": una semplice scritta sottolineata, non un pulsante. */
	.plan__link {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		font-size: var(--text-sm);
		font-weight: 700;
		color: var(--plan-testo);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1.5px;
		transition: color var(--dur-base);
	}

	.plan__link:hover,
	.plan__link:focus-visible {
		color: var(--plan-evid);
	}

	/* Apertura e chiusura morbide dove il browser lo permette (altrimenti si apre di colpo). */
	@supports (interpolate-size: allow-keywords) {
		.plan__acc {
			interpolate-size: allow-keywords;
		}

		.plan__acc::details-content {
			block-size: 0;
			overflow: clip;
			transition: block-size 0.35s var(--ease-out-crit), content-visibility 0.35s allow-discrete;
		}

		.plan__acc[open]::details-content {
			block-size: auto;
		}
	}

	/* Telefono e tablet: barra e corpo piu' stretti, sigla del giorno piu' piccola. */
	@media (max-width: 900px) {
		.plan__sum {
			min-height: 56px;
			padding: 10px 16px;
		}

		.plan__corpo {
			padding: 16px;
		}

		.plan__giorno {
			grid-template-columns: 3rem minmax(0, 1fr);
			gap: 8px;
		}

		/* Solo l'ora di inizio: tre caselle per riga, tutte larghe uguali (anche l'ultima). */
		.plan__ore {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(4rem, 1fr));
		}

		.plan__ora {
			padding-inline: 8px;
		}
	}
</style>

<script>
	// Evidenzia il giorno di oggi (getDay: 0 = domenica).
	const sigle = ['DOM', 'LUN', 'MAR', 'MER', 'GIO', 'VEN', 'SAB'];
	const oggi = sigle[new Date().getDay()];
	document.querySelectorAll<HTMLElement>('.plan__giorno').forEach((g) => {
		if (g.dataset.giorno === oggi) g.classList.add('is-oggi');
	});
</script>
