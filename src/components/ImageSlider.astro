---
/*
 * Piccolo carosello di foto a scorrimento manuale (frecce, tastiera, swipe).
 * Riempie il contenitore (position: relative; overflow: hidden, con altezza
 * propria). Niente scorrimento automatico: chi legge decide quando cambiare foto.
 *
 *   <ImageSlider images={['/wp-content/uploads/…jpg', …]} label="Foto del Termarium" />
 */
import Img from './Img.astro';

interface Props {
	images: string[];
	/** Nome del carosello, letto dagli screen reader. */
	label: string;
	/** Descrizione comune delle foto (es. nome del corso): ogni foto diventa "<descrizione> - foto N". */
	alt?: string;
	sizes?: string;
}

const { images, label, alt, sizes = '(max-width: 900px) 90vw, 46vw' } = Astro.props;
---

<div class="sl" role="group" aria-roledescription="carosello" aria-label={label}>
	<ul class="sl__track" tabindex="0" aria-label={`${label}: scorri per vedere le foto`}>
		{
			images.map((src, i) => (
				<li class="sl__slide" aria-label={`Foto ${i + 1} di ${images.length}`}>
					<Img src={src} alt={alt ? `${alt} - foto ${i + 1}` : ''} sizes={sizes} />
				</li>
			))
		}
	</ul>
	<button type="button" class="sl__btn sl__btn--prev" aria-label="Foto precedente">
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
	</button>
	<button type="button" class="sl__btn sl__btn--next" aria-label="Foto successiva">
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
	</button>
	<p class="sl__count" aria-hidden="true"><span data-sl-now>1</span> / {images.length}</p>
</div>

<style>
	.sl {
		position: absolute;
		inset: 0;
	}

	.sl__track {
		display: flex;
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.sl__track::-webkit-scrollbar {
		display: none;
	}

	.sl__track:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: -3px;
	}

	.sl__slide {
		flex: 0 0 100%;
		height: 100%;
		scroll-snap-align: center;
	}

	.sl__slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.sl__btn {
		position: absolute;
		top: 50%;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.6);
		color: var(--text-on-dark);
		cursor: pointer;
		transform: translateY(-50%);
		transition: background var(--dur-base);
	}

	.sl__btn:hover {
		background: var(--accent);
	}

	.sl__btn:focus-visible {
		outline: 3px solid var(--text-on-dark);
		outline-offset: 2px;
	}

	.sl__btn--prev {
		left: 12px;
	}

	.sl__btn--next {
		right: 12px;
	}

	.sl__btn:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.sl__count {
		position: absolute;
		left: 12px;
		bottom: 12px;
		margin: 0;
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: rgba(0, 0, 0, 0.6);
		color: var(--text-on-dark);
		font-size: var(--text-xs);
		font-weight: 700;
	}

	@media (prefers-reduced-motion: no-preference) {
		.sl__track {
			scroll-behavior: smooth;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.sl').forEach((sl) => {
		const track = sl.querySelector<HTMLElement>('.sl__track')!;
		const prev = sl.querySelector<HTMLButtonElement>('.sl__btn--prev')!;
		const next = sl.querySelector<HTMLButtonElement>('.sl__btn--next')!;
		const now = sl.querySelector<HTMLElement>('[data-sl-now]');
		const totale = track.children.length;

		const indice = () => Math.round(track.scrollLeft / track.clientWidth);
		const vai = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(totale - 1, i)) * track.clientWidth });

		function aggiorna() {
			const i = indice();
			prev.disabled = i <= 0;
			next.disabled = i >= totale - 1;
			if (now) now.textContent = String(i + 1);
		}

		prev.addEventListener('click', () => vai(indice() - 1));
		next.addEventListener('click', () => vai(indice() + 1));
		track.addEventListener('scroll', aggiorna, { passive: true });
		track.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') vai(indice() - 1);
			else if (e.key === 'ArrowRight') vai(indice() + 1);
			else return;
			e.preventDefault();
		});
		aggiorna();
	});
</script>
