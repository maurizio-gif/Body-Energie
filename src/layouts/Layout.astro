---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import { imgSources } from '../lib/img';

interface Props {
	title: string;
	description?: string;
	/** "overlay": la pagina parte con una foto a tutta altezza che passa sotto l'header
	 *  (home e pagine con hero). "solid" (default): il contenuto parte sotto l'header. */
	headerTone?: 'overlay' | 'solid';
	/** Sezioni a blocchi con fasce di colore tra l'una e l'altra (la home). */
	stack?: boolean;
	/** Foto per l'anteprima quando il link viene condiviso (default: una foto del centro). */
	image?: string;
	/** Dati strutturati (schema.org) da inserire nella pagina. */
	jsonLd?: Record<string, unknown>;
	/** Nome della pagina per il percorso Home > Pagina (dati strutturati). */
	breadcrumb?: string;
	/** Pagina da non indicizzare (es. 404): robots noindex e niente canonical. */
	noindex?: boolean;
}

const { title, description, headerTone = 'solid', stack = false, image, jsonLd, breadcrumb, noindex = false } = Astro.props;
const overlay = headerTone === 'overlay';

const metaDescription =
	description ?? 'Body Energie: fitness, benessere e sport a Villafranca di Verona. Palestra, piscina, corsi e Centro del Benessere.';

const gtmId = import.meta.env.PUBLIC_GTM_ID;
const cookieyesId = import.meta.env.PUBLIC_COOKIEYES_ID;
// Stesso indirizzo in sviluppo e in produzione: sempre con la barra finale, come il vecchio sito.
const percorso = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(percorso, Astro.site);
// Foto di condivisione: la variante WebP piu' grande (1600px), molto piu' leggera dell'originale.
const percorsoLd = breadcrumb
	? {
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
				{ '@type': 'ListItem', position: 2, name: breadcrumb, item: canonicalURL.href },
			],
		}
	: undefined;
const datiStrutturati = [jsonLd, percorsoLd].filter(Boolean);
const ogImage = new URL(imgSources(image ?? '/wp-content/uploads/2025/12/Body-Energie-Ambienti-57-scaled.jpg').src, Astro.site).href;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />

		<!-- Segnala che c'e' JavaScript: le animazioni in entrata nascondono gli
		     elementi solo in questo caso, cosi' senza JS il contenuto si vede. -->
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>

		<!-- Google Consent Mode v2: default a "denied" prima di qualunque altro tag, come sugli altri siti del gruppo -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('consent', 'default', {
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				analytics_storage: 'denied',
				functionality_storage: 'granted',
				security_storage: 'granted',
			});
		</script>

		{
			gtmId && (
				<script is:inline define:vars={{ gtmId }}>
					(function (w, d, s, l, i) {
						w[l] = w[l] || [];
						w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
						var f = d.getElementsByTagName(s)[0],
							j = d.createElement(s),
							dl = l != 'dataLayer' ? '&l=' + l : '';
						j.async = true;
						j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
						f.parentNode.insertBefore(j, f);
					})(window, document, 'script', 'dataLayer', gtmId);
				</script>
			)
		}

		{
			cookieyesId && (
				<script
					id="cookieyes"
					type="text/javascript"
					src={`https://cdn-cookieyes.com/client_data/${cookieyesId}/script.js`}
					is:inline
				/>
			)
		}

		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Font del brand: solo Montserrat, ovunque (titoli e testo), servito dal sito
		     (vedi @font-face in global.css); si precarica solo il tondo. -->
		<link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />

		<link rel="icon" href="/wp-content/uploads/2025/12/Favicon-body-Energie.png" />
		<meta name="description" content={metaDescription} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
		<title>{title}</title>

		<!-- Anteprima quando il link viene condiviso (WhatsApp, Facebook, LinkedIn...) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Body Energie" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		{!noindex && <meta property="og:url" content={canonicalURL} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />

		<slot name="head" />

		{datiStrutturati.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
	</head>
	<body>
		{
			gtmId && (
				<noscript>
					<iframe
						src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
						height="0"
						width="0"
						style="display:none;visibility:hidden"
					/>
				</noscript>
			)
		}

		<a class="skip-link" href="#main">Vai al contenuto</a>
		<Header />
		<main id="main" class:list={{ 'main--stack': stack, 'main--offset': !overlay }}>
			<slot />
		</main>
		<Footer />
		<LeadModal />

		<script>
			import { initConsentBridge } from '../lib/consent.client.js';
			import { initMetaPixel } from '../lib/metaPixel.client.js';

			initConsentBridge();
			initMetaPixel();
		</script>

		<script>
			// Un solo observer per tutta la pagina: ogni elemento sceglie la
			// variante con data-anim e si rivela una volta sola (niente replay
			// se si torna a scorrere in su).
			const obs = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const el = entry.target as HTMLElement;
						const delay = el.dataset.animDelay ? parseInt(el.dataset.animDelay, 10) : 0;
						window.setTimeout(() => el.classList.add('is-visible'), delay);
						obs.unobserve(el);
					});
				},
				{ threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
			);

			document.querySelectorAll<HTMLElement>('[data-anim]').forEach((el) => obs.observe(el));
		</script>
	</body>
</html>
