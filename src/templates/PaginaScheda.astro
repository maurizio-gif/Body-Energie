---
/*
 * Template "scheda": hero con foto, eventuale introduzione (titolo grande + testo),
 * eventuale striscia di foto, uno o piu' blocchi media+testo alternati, domande
 * frequenti. Serve le schede corso (tipo "corso") e le pagine servizio (tipo
 * "servizio": sala pesi, personal training, termario, nuoto, body camp, ciclismo,
 * centro estetico, body lab). I contenuti arrivano dal JSON della pagina
 * (src/data/pagine/<slug>.json), estratto dal sito WordPress originale.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import CourseBlock from '../components/CourseBlock.astro';
import SectionTitle from '../components/SectionTitle.astro';
import IntroTitolo from '../components/IntroTitolo.astro';
import IndiceAncore from '../components/IndiceAncore.astro';
import AltriCorsi from '../components/AltriCorsi.astro';
import PlanningSezione from '../components/PlanningSezione.astro';
import correlati from '../data/correlati.json';

interface Pulsante {
	testo: string;
	/** Apre il modulo contatti con questo "interesse". */
	interesse?: string;
	/** Oppure e' un normale collegamento. */
	href?: string;
}

interface Props {
	pagina: {
		tipo: 'corso' | 'servizio';
		slug: string;
		nome: string;
		seo: { title: string; description: string };
		hero: { titolo: string; parole?: string[]; immagine: string; pulsanti?: Pulsante[] };
		galleria?: string[];
		/** Introduzione con titolo grande (al posto di un primo blocco di solo testo). */
		intro?: { titolo: string; html: string } | null;
		/** Elenco di collegamenti alle sezioni della pagina (Body Lab, Sala Pesi). */
		percorsi?: { titolo?: string; voci: { testo: string; href: string }[] } | null;
		blocchi: any[];
	};
}

const { pagina } = Astro.props;
const foto = (pagina.galleria ?? []).map((src) => ({ src }));
// L'introduzione conta come primo blocco nell'alternanza di colori e lati.
const scarto = pagina.intro ? 1 : 0;

// Colori delle sezioni, dall'alto in basso: nero e arancione alternati, sempre a partire dal nero.
// Introduzione, striscia di foto, indice delle sezioni e "Altri corsi" stanno sul nero. Dove il colore
// cambia, la sezione che finisce sfuma nella successiva (36 + 40 di sfumo + 36, vedi .sfuma); dopo
// l'ultima sezione c'e' la CTA arancione del footer.
type Tono = 'nero' | 'arancio';
const tonoBlocco = (i: number): Tono => ((i + scarto) % 2 === 1 ? 'arancio' : 'nero');
const conIndice = !pagina.intro && !!pagina.percorsi;
const conAltri = ((correlati as Record<string, string[]>)[pagina.slug] ?? []).length > 0;
const sezioni: { k: string; tono: Tono }[] = [
	...(pagina.intro ? [{ k: 'intro', tono: 'nero' as Tono }] : []),
	...(foto.length ? [{ k: 'foto', tono: 'nero' as Tono }] : []),
	...pagina.blocchi.flatMap((_, i) => [{ k: `b${i}`, tono: tonoBlocco(i) }, ...(i === 0 && conIndice ? [{ k: 'indice', tono: 'nero' as Tono }] : [])]),
	...(conAltri ? [{ k: 'altri', tono: 'nero' as Tono }] : []),
];
const pos = (k: string) => sezioni.findIndex((s) => s.k === k);
/** Colore della sezione dopo (l'arancione del footer dopo l'ultima). */
const dopo = (k: string): Tono => sezioni[pos(k) + 1]?.tono ?? 'arancio';
/** Cambia colore subito dopo questa sezione: in fondo c'e' lo sfumo. */
const sfuma = (k: string) => dopo(k) !== sezioni[pos(k)].tono;
/** La sezione prima finisce con uno sfumo: meno spazio in cima. */
const dopoSfumo = (k: string) => pos(k) > 0 && sfuma(sezioni[pos(k) - 1].k);

// Le schede corso hanno sempre "Prova ora" e il planning; le altre pagine
// portano i pulsanti che avevano sul vecchio sito (anche nessuno).
const pulsanti: Pulsante[] =
	pagina.hero.pulsanti ??
	[
		{ testo: 'Prova ora', interesse: pagina.slug },
		{ testo: 'Planning settimanale', href: '/orari' },
	];

// Una scheda corso senza video usa una foto della pagina; le altre pagine no.
const sfondoSenzaMedia = (i: number) =>
	pagina.tipo !== 'corso' ? undefined : foto.length ? foto[i % foto.length].src : pagina.hero.immagine;
---

<Layout title={pagina.seo.title} description={pagina.seo.description} image={pagina.hero.immagine} breadcrumb={pagina.nome} headerTone="overlay">
	<PageHero image={pagina.hero.immagine} title={pagina.hero.titolo} words={pagina.hero.parole}>
		{
			pulsanti.map((p) =>
				p.interesse ? (
					<button class="btn btn--pillola btn--pillola-chiara btn--lg" type="button" data-open-contact data-interest={p.interesse}>
						{p.testo}
					</button>
				) : (
					<a class="btn btn--light btn--lg" href={p.href}>
						{p.testo}
					</a>
				)
			)
		}
	</PageHero>

	{
		pagina.intro && (
			<IntroTitolo titolo={pagina.intro.titolo} html={pagina.intro.html} sfumoA={sfuma('intro') ? 'var(--accent)' : undefined}>
				{pagina.percorsi && <IndiceAncore voci={pagina.percorsi.voci} label={pagina.percorsi.titolo ?? 'Sezioni della pagina'} griglia />}
			</IntroTitolo>
		)
	}

	{
		foto.length > 0 && (
			<section
				class:list={['scheda-foto', { sfuma: sfuma('foto') }]}
				style={sfuma('foto') ? '--da:var(--bg-dark);--a:var(--accent)' : undefined}
				aria-label={`Foto: ${pagina.nome}`}
			>
				<PhotoMarquee images={foto} height={300} cardWidth={420} />
			</section>
		)
	}

	{
		pagina.blocchi.map((blocco, i) => (
			<>
				<CourseBlock
					blocco={blocco}
					fallbackImage={sfondoSenzaMedia(i)}
					reverse={(i + scarto) % 2 === 1}
					tone={tonoBlocco(i) === 'arancio' ? 'arancio' : 'dark'}
					compatto={i === 0 && conIndice}
					sfumoA={sfuma(`b${i}`) ? dopo(`b${i}`) : undefined}
					dopoSfumo={dopoSfumo(`b${i}`)}
				>
					<PlanningSezione slug={pagina.slug} blocco={i} titolo={blocco.titolo ?? pagina.nome} tone={tonoBlocco(i) === 'arancio' ? 'arancio' : 'dark'} />
				</CourseBlock>
				{i === 0 && conIndice && pagina.percorsi && (
					<div
						class:list={['percorsi', 'sez', { sfuma: sfuma('indice') }]}
						style={sfuma('indice') ? '--da:var(--bg-dark);--a:var(--accent)' : undefined}
					>
						{pagina.percorsi.titolo && (
							<SectionTitle tone="dark-bg" gap={20}>
								{pagina.percorsi.titolo}
							</SectionTitle>
						)}
						<div class="container-wide">
							<IndiceAncore voci={pagina.percorsi.voci} label={pagina.percorsi.titolo ?? 'Sezioni della pagina'} />
						</div>
					</div>
				)}
			</>
		))
	}

	<AltriCorsi slug={pagina.slug} titolo={pagina.tipo === 'corso' ? 'Altri corsi' : 'Scopri anche'} dopoSfumo={conAltri && dopoSfumo('altri')} />
</Layout>

<style>
	.scheda-foto {
		padding-block: 24px;
		background: var(--bg-dark);
	}

	/* Se dopo la striscia di foto il colore cambia, lo sfumo sta sotto le foto (non sopra). */
	.scheda-foto.sfuma {
		padding-bottom: calc(24px + var(--sez-sfumo));
	}

	/* Indice sotto il primo blocco (Body Lab): lo stesso spazio che c'e' tra hero e testo. I link
	   sono alti 44px con il testo al centro: sotto si tolgono 10px. */
	.percorsi {
		padding-block: 20px calc(var(--sez-pb) - 10px);
		background: var(--bg-dark);
	}
</style>
