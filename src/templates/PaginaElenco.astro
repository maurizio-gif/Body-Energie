---
/*
 * Template "elenco": la pagina dei Corsi Fitness. Hero, introduzione e un blocco per
 * ogni famiglia di corsi (Respira, Ride, Dinamica, Attiva): titolo con riga e card
 * come quelle delle attivita' della home (ActivityGrid). La foto di ogni card e' la
 * hero della scheda del corso. Il vecchio sito non aveva descrizioni per le card.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import IntroTitolo from '../components/IntroTitolo.astro';
import ActivityGrid from '../components/ActivityGrid.astro';

interface Props {
	pagina: {
		slug: string;
		nome: string;
		seo: { title: string; description: string };
		hero: { titolo: string; parole?: string[]; immagine: string; pulsanti?: { testo: string; interesse?: string; href?: string }[] };
		intro: { titolo: string; html: string };
		gruppi: { titolo: string; html: string; immagine: string; corsi: { nome: string; slug: string }[] }[];
	};
}

const { pagina } = Astro.props;

// Foto di testata di ogni scheda corso, per le card.
const schede = import.meta.glob('../data/pagine/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const fotoCorso: Record<string, string> = {};
for (const s of Object.values(schede)) if (s.hero?.immagine) fotoCorso[s.slug] = s.hero.immagine;

const card = (corsi: { nome: string; slug: string }[]) =>
	corsi.map((c) => ({ href: `/${c.slug}`, image: fotoCorso[c.slug], title: c.nome }));

// Come in home: fino a 4 card in una riga; con 5 o piu', tre in alto e il resto
// in una seconda riga a due colonne.
const colonne = (n: number) => (n <= 4 ? n : 3);

// Fondi alternati, come i blocchi delle attivita' nella home.
const fondi = ['var(--bg-dark-soft)', 'var(--bg-dark)'];
---

<Layout title={pagina.seo.title} description={pagina.seo.description} image={pagina.hero.immagine} breadcrumb={pagina.nome} headerTone="overlay">
	<PageHero image={pagina.hero.immagine} title={pagina.hero.titolo} words={pagina.hero.parole}>
		{
			pagina.hero.pulsanti?.map((p) =>
				p.interesse ? (
					<button class="btn btn--lg" type="button" data-open-contact data-interest={p.interesse}>
						{p.testo}
					</button>
				) : (
					<a class="btn btn--light btn--lg" href={p.href}>
						{p.testo}
					</a>
				)
			)
		}
	</PageHero>

	<IntroTitolo titolo={pagina.intro.titolo} html={pagina.intro.html} />

	{
		pagina.gruppi.map((g, i) => {
			const items = card(g.corsi);
			const prima = items.slice(0, colonne(items.length));
			const resto = items.slice(prima.length);
			return (
				<section class="gruppo on-dark" style={`--gruppo-bg:${fondi[i % fondi.length]}`}>
					<SectionTitle tone="dark-bg" gap={16}>
						{g.titolo}
					</SectionTitle>
					<div class="gruppo__desc container-wide" set:html={g.html} />
					<ActivityGrid items={prima} columns={prima.length} gapTop={28} />
					{resto.length > 0 && <ActivityGrid items={resto} columns={2} startIndex={prima.length} gapTop={20} />}
				</section>
			);
		})
	}
</Layout>

<style>
	/* Stessa struttura dei blocchi "Attivita'" della home: fondo alternato, 56px sopra e sotto. */
	.gruppo {
		padding-block: 56px;
		background: var(--gruppo-bg);
		color: var(--text-on-dark);
	}

	.gruppo__desc {
		max-width: calc(60rem + 2 * var(--gutter));
		font-size: var(--text-md);
		line-height: 1.7;
	}

	.gruppo__desc :global(p) {
		margin: 0;
	}
</style>
