---
/*
 * Planning settimanale dei corsi. Struttura presa dalla pagina Corsi/Orari di Recomp360:
 * hero con foto, sezione "Orari" con tab dei giorni, pannello a righe per fascia oraria,
 * frecce giorno precedente/successivo, legenda e avviso finale.
 *
 * Adattamenti per Body Energie: nella stessa fascia ci sono fino a 5 lezioni (le righe
 * raggruppano per orario), le categorie (Dinamica, Attiva…) prendono il posto
 * dell'intensita' e fanno anche da filtro, e toccando una lezione si apre un pop-up con
 * immagine/video e sintesi del corso (come in Recomp360), con il link alla scheda completa.
 *
 * I dati (src/data/orario-corsi.json) sono quelli del widget HTML della pagina "Planning
 * Orari" del vecchio sito. Tutti i giorni stanno nell'HTML: senza JavaScript si leggono
 * uno dopo l'altro; con JavaScript compaiono tab, frecce e filtro, partendo da oggi.
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PlanningGiorni from '../components/PlanningGiorni.astro';
import { giorniDelPlanning, nomiCategoria } from '../lib/planning';
import { idSezione } from '../lib/ancora';
import { imgSources } from '../lib/img';
import orario from '../data/orario-corsi.json';
import { orari as orariApertura } from '../data/orari';
import schedeCorsi from '../data/orari-schede.json';

// Scheda del corso di ogni lezione (e quale blocco della scheda: la pagina Acqua ne ha tre).
// Core non ha una scheda: resta senza link e senza pop-up.
const CORSI_SCHEDA: Record<string, { slug: string; blocco?: number }> = schedeCorsi;

// Pop-up del corso: immagine (e video, se c'e'), durata e una sintesi del testo della scheda.
const pagine = import.meta.glob('../data/pagine/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const perSlug: Record<string, any> = {};
for (const p of Object.values(pagine)) perSlug[p.slug] = p;

// Le prime frasi del testo, fino a circa 240 caratteri (sempre almeno la prima).
function sintesi(html: string): string {
	const testo = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
	const frasi = testo.split(/(?<=[.!?])\s+/);
	let out = frasi[0] ?? '';
	for (const f of frasi.slice(1)) {
		if ((out + ' ' + f).length > 240) break;
		out += ' ' + f;
	}
	return out;
}

const SCHEDE: Record<string, string> = {};
const CORSI: Record<string, { titolo: string; sintesi: string; durata: string; href: string; img: { src: string; srcset?: string }; video: string | null }> = {};
for (const [nome, { slug, blocco = 0 }] of Object.entries(CORSI_SCHEDA)) {
	const pagina = perSlug[slug];
	const b = pagina.blocchi[blocco];
	// Dal secondo blocco in poi (es. Acqua Bike nella pagina Acqua) il link porta alla sezione giusta.
	const indirizzo = blocco > 0 ? `/${slug}#${idSezione(b)}` : `/${slug}`;
	SCHEDE[nome] = indirizzo;
	CORSI[nome] = {
		titolo: nome,
		sintesi: sintesi(b.descrizioneHtml),
		durata: b.dettagli.find((d: { icona: string | null }) => d.icona?.includes('clock'))?.testo ?? '',
		href: indirizzo,
		img: imgSources(pagina.hero.immagine),
		video: b.video ?? null,
	};
}

const categorie = Object.entries(nomiCategoria);
const giorni = giorniDelPlanning();
---

<Layout
	title="Orario corsi - Body Energie | Villafranca di Verona"
	description={`Orario dei corsi di Body Energie a Villafranca di Verona, stagione ${orario.stagione}: Dinamica, Attiva, Respira, Acqua e Forma, giorno per giorno.`}
	headerTone="overlay"
	image="/wp-content/uploads/2025/11/Body-Energie-Ambienti-14-scaled.jpg"
	breadcrumb="Orario corsi"
>
	<PageHero image="/wp-content/uploads/2025/11/Body-Energie-Ambienti-14-scaled.jpg" title="orario" words={['corsi']}>
		<button class="btn btn--lg" type="button" data-open-contact data-interest="prova-gratuita">Prova ora</button>
		<button class="btn btn--light btn--lg" type="button" data-open-contact data-interest="informazioni">Contattaci</button>
	</PageHero>

	<section class="orari on-dark" data-or>
		<SectionTitle accent="corsi" gap={16}>Orari</SectionTitle>
		<p class="orari__valid container-wide">Stagione {orario.stagione} · {orario.validita}</p>
		<p class="orari__pdf container-wide">
			<a class="btn btn--light" href="/orari-corsi-body-energie.pdf" download="Orari-Corsi-Body-Energie.pdf">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M4 19h16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				Scarica il PDF degli orari
			</a>
			<span class="orari__pdf-info">PDF A4 orizzontale · sempre allineato a questo planning</span>
		</p>

		<div class="orari__wrap container-wide">
			<div class="legenda" role="group" aria-label="Filtra per categoria">
				<button type="button" class="legenda__voce is-on" aria-pressed="true" data-cat="all">
					<span class="dot"></span>Tutti
				</button>
				{
					categorie.map(([id, nome]) => (
						<button type="button" class={`legenda__voce cls--${id}`} aria-pressed="false" data-cat={id}>
							<span class="dot"></span>
							{nome}
						</button>
					))
				}
			</div>

			<PlanningGiorni giorni={giorni} id="or" collegamenti={SCHEDE} tabsFissi />

			<!-- Orari di apertura del centro e del Termarium (nel planning originale stavano sotto agli orari dei corsi) -->
			<div class="apertura">
				<h3 class="apertura__title" id="apertura-titolo">Orari di apertura</h3>
				<div class="apertura__grid" role="group" aria-labelledby="apertura-titolo">
					{
						orariApertura.map((o) => (
							<div class="apertura__card">
								<p class="apertura__label">{o.titolo}</p>
								<dl class="apertura__list">
									{o.righe.map((r) => (
										<div>
											<dt>{r.giorni}</dt>
											<dd>{r.ore}</dd>
										</div>
									))}
								</dl>
							</div>
						))
					}
				</div>
			</div>

			<p class="orari__note" set:html={orario.note} />
		</div>
	</section>

	<!-- Pop-up del corso: lo riempie lo script con i dati della lezione toccata -->
	<script is:inline type="application/json" id="corsi-dati" set:html={JSON.stringify(CORSI).replace(/</g, '\\u003c')} />

	<dialog id="corso-modal" class="cm" aria-labelledby="cm-nome">
		<button type="button" class="cm__close" aria-label="Chiudi" data-cm-close>
			<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
				<path d="M18 6L6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
			</svg>
		</button>
		<div class="cm__media">
			<img class="cm__img" alt="" />
			<video class="cm__video" muted loop playsinline preload="none" hidden></video>
		</div>
		<div class="cm__body">
			<p class="cm__meta">
				<span class="cm__cat"><span class="dot" aria-hidden="true"></span><span data-cm-cat></span></span>
				<span class="cm__dur" data-cm-dur></span>
			</p>
			<h3 class="cm__nome" id="cm-nome"></h3>
			<p class="cm__sintesi" data-cm-sintesi></p>
			<a class="btn cm__link" href="/" data-cm-link>Scopri il corso <span aria-hidden="true">→</span></a>
		</div>
	</dialog>
</Layout>

<style>
	.orari {
		padding-block: clamp(40px, 6vw, 80px);
		background: var(--bg-dark);
		color: var(--text-on-dark);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	.orari__valid {
		margin: 0 0 14px;
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--text-muted-on-dark);
	}

	/* ---- Download del PDF degli orari ---- */
	.orari__pdf {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 16px;
		margin-top: 0;
		margin-bottom: 28px;
	}

	.orari__pdf .btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.orari__pdf-info {
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--text-muted-on-dark);
	}

	/* ---- Legenda delle categorie (e filtro) ---- */
	.legenda {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 20px;
	}

	.legenda__voce {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 6px 16px;
		border: 2px solid var(--border-on-dark);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--text-on-dark);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 700;
		cursor: pointer;
		transition: background var(--dur-base), border-color var(--dur-base), color var(--dur-base);
	}

	.legenda__voce:hover {
		border-color: var(--text-on-dark);
	}

	.legenda__voce[aria-pressed='true'] {
		border-color: var(--text-on-dark);
		background: var(--text-on-dark);
		color: var(--text);
	}

	.legenda__voce:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}

	/* ---- Orari di apertura ----
	   Stessi box del "Vieni a trovarci" nel footer (card crema, etichetta arancione e orari nel
	   font dei titoli, testo nero): se cambiano di la', vanno allineati anche qui. */
	.apertura {
		margin-top: clamp(32px, 5vw, 56px);
	}

	.apertura__title {
		margin: 0 0 16px;
		font-size: var(--text-xl);
		font-weight: 900;
		text-transform: uppercase;
		color: var(--text-on-dark);
	}

	.apertura__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
	}

	.apertura__card {
		padding: 24px 26px;
		border-radius: var(--radius-lg);
		background: var(--bg-alt);
		color: var(--text);
	}

	.apertura__label {
		margin: 0 0 10px;
		font-family: var(--font-heading);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: var(--text-xs);
		font-weight: 800;
		color: var(--accent-on-light);
	}

	.apertura__list {
		margin: 0;
	}

	.apertura__list div {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		padding: 12px 0;
		border-bottom: 1px solid var(--border-strong);
	}

	.apertura__list div:last-child {
		padding-bottom: 0;
		border-bottom: none;
	}

	.apertura__list dt {
		font-size: var(--text-sm);
		color: rgba(0, 0, 0, 0.7);
	}

	.apertura__list dd {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--text);
	}

	.orari__note {
		margin: 24px 0 0;
		font-size: var(--text-sm);
		line-height: 1.7;
		color: var(--text-muted-on-dark);
	}

	/* ---- Pop-up del corso (come in Recomp360) ---- */
	.cm {
		width: min(480px, 92vw);
		max-height: 90vh;
		max-height: 90svh;
		margin: auto;
		padding: 0;
		overflow: auto;
		overscroll-behavior: contain;
		border: 1px solid var(--border-on-dark);
		border-top: 2px solid var(--accent);
		border-radius: var(--radius-lg);
		background: var(--bg-dark-soft);
		color: var(--text-on-dark);
	}

	.cm::backdrop {
		background: rgba(0, 0, 0, 0.75);
	}

	.cm__close {
		position: absolute;
		top: 10px;
		right: 10px;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.6);
		color: var(--text-on-dark);
		cursor: pointer;
		transition: background var(--dur-base);
	}

	.cm__close:hover {
		background: var(--accent);
		color: var(--text);
	}

	.cm__close:focus-visible {
		outline: 3px solid var(--text-on-dark);
		outline-offset: 2px;
	}

	.cm__media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #000;
	}

	.cm__img,
	.cm__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cm__video[hidden] {
		display: none;
	}

	.cm__body {
		display: grid;
		justify-items: start;
		gap: 12px;
		padding: 24px;
	}

	.cm__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 14px;
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-muted-on-dark);
	}

	.cm__cat {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.cm__dur:empty {
		display: none;
	}

	.cm__nome {
		margin: 0;
		font-size: var(--text-xl);
		font-weight: 900;
		text-transform: uppercase;
		color: var(--accent);
	}

	.cm__sintesi {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.7;
		color: var(--text-on-dark);
	}

	.cm__link {
		margin-top: 6px;
	}
</style>

<script>
	const radice = document.querySelector<HTMLElement>('[data-or]');
	if (radice) {
		// Tab e frecce dei giorni li gestisce il componente PlanningGiorni: qui restano il filtro per
		// categoria e il pop-up del corso.
		const pannelli = [...radice.querySelectorAll<HTMLElement>('.day-panel')];
		const voci = [...radice.querySelectorAll<HTMLButtonElement>('.legenda__voce')];
		let categoria = 'all';

		// Mostra le lezioni della categoria scelta e nasconde le fasce rimaste vuote.
		function applica() {
			for (const p of pannelli) {
				let visibili = 0;
				for (const slot of p.querySelectorAll<HTMLElement>('.slot')) {
					let n = 0;
					for (const c of slot.querySelectorAll<HTMLElement>('.cls')) {
						const mostra = categoria === 'all' || c.dataset.c === categoria;
						c.hidden = !mostra;
						if (mostra) n++;
					}
					slot.hidden = n === 0;
					visibili += n;
				}
				p.querySelector<HTMLElement>('.day-panel__empty')!.hidden = visibili > 0;
			}
		}

		voci.forEach((b) =>
			b.addEventListener('click', () => {
				categoria = b.dataset.cat!;
				voci.forEach((x) => {
					x.classList.toggle('is-on', x === b);
					x.setAttribute('aria-pressed', String(x === b));
				});
				applica();
			})
		);

		applica();

		// ---- Pop-up del corso: immagine (o video), durata e sintesi ----------------------
		// Senza JavaScript le lezioni restano normali link alla scheda del corso.
		type Corso = { titolo: string; sintesi: string; durata: string; href: string; img: { src: string; srcset?: string }; video: string | null };
		const dati: Record<string, Corso> = JSON.parse(document.getElementById('corsi-dati')?.textContent ?? '{}');
		const dlg = document.getElementById('corso-modal') as HTMLDialogElement | null;
		if (dlg) {
			const img = dlg.querySelector<HTMLImageElement>('.cm__img')!;
			const video = dlg.querySelector<HTMLVideoElement>('.cm__video')!;
			const nome = dlg.querySelector<HTMLElement>('.cm__nome')!;
			const sintesi = dlg.querySelector<HTMLElement>('[data-cm-sintesi]')!;
			const cat = dlg.querySelector<HTMLElement>('[data-cm-cat]')!;
			const dur = dlg.querySelector<HTMLElement>('[data-cm-dur]')!;
			const link = dlg.querySelector<HTMLAnchorElement>('[data-cm-link]')!;
			const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;

			function ferma() {
				video.pause();
				video.removeAttribute('src');
				video.load(); // interrompe un eventuale scaricamento
				video.hidden = true;
				document.body.classList.remove('lf-locked');
			}

			function apri(a: HTMLAnchorElement) {
				const c = dati[a.dataset.corso ?? ''];
				if (!c) {
					location.href = a.href;
					return;
				}
				const riga = a.closest<HTMLElement>('.cls')!;
				dlg!.style.setProperty('--c', getComputedStyle(riga).getPropertyValue('--c'));
				nome.textContent = c.titolo;
				sintesi.textContent = c.sintesi;
				cat.textContent = a.querySelector('.cls__cat')?.textContent ?? '';
				dur.textContent = c.durata;
				link.href = c.href;
				img.src = c.img.src;
				if (c.img.srcset) {
					img.srcset = c.img.srcset;
					img.sizes = '(max-width: 560px) 92vw, 480px';
				} else img.removeAttribute('srcset');
				document.body.classList.add('lf-locked');
				dlg!.showModal();
				// Il video parte solo all'apertura (pesa qualche MB) e solo senza "riduci movimento":
				// finche' non e' pronto si vede la foto.
				if (c.video && !ridotto) {
					video.src = c.video;
					video.addEventListener(
						'canplay',
						() => {
							video.hidden = false;
							video.play().catch(() => {});
						},
						{ once: true }
					);
					video.load();
				}
			}

			radice.querySelectorAll<HTMLAnchorElement>('a[data-corso]').forEach((a) =>
				a.addEventListener('click', (e) => {
					// Apri in una nuova scheda (ctrl/cmd/maiusc/tasto centrale): resta il link normale.
					if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
					e.preventDefault();
					apri(a);
				})
			);
			dlg.querySelector('[data-cm-close]')!.addEventListener('click', () => dlg.close());
			// Un tocco sullo sfondo scuro (il target e' il dialog stesso) chiude il pop-up.
			dlg.addEventListener('click', (e) => {
				if (e.target === dlg) dlg.close();
			});
			dlg.addEventListener('close', ferma);
		}
	}
</script>
